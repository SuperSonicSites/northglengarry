/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'

# Fingerprinted build output is safe to cache hard. The middleware overrides
# Cache-Control to private on every authenticated response, so this only
# governs how the browser itself stores them.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
